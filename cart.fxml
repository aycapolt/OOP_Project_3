<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="application.cashierscreens.CartController" alignment="CENTER" spacing="20">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Shopping Cart" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="firstNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Last Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="lastNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Age:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="ageField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="Additional Products:" style="-fx-font-size: 18px;"/>
    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Beverages:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="beveragesComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Biscuits:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="biscuitsComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Toys:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="toysComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Button text="Add to Cart" onAction="#addToCart" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
    </GridPane>

    <Label text="Shopping Cart Items:" style="-fx-font-size: 18px;"/>
    <ListView fx:id="shoppingCartList" prefHeight="150" prefWidth="400"/>

    <Label fx:id="totalPriceLabel" text="Total: $0.00" style="-fx-font-size: 16px;"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Proceed" onAction="#proceed"/>
        <Button text="Back" onAction="#goBack"/>
        <Button text="Logout" onAction="#logout" style="-fx-background-color: red; -fx-text-fill: white;"/>
    </HBox>
</VBox>